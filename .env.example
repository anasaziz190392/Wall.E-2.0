# Optional: only needed if you enable "Use LLM agents" in the sidebar.
# LiteLLM model strings: "gpt-4o-mini", "anthropic/claude-sonnet-4-5", "gemini/gemini-1.5-flash", "ollama/llama3"
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Google Form intake (see README). Response sheet link created by google_form_setup.gs
GOOGLE_SHEET_URL=
# Optional, for a private sheet: paste the service-account key JSON on one line
GOOGLE_SERVICE_ACCOUNT_JSON=

# E-mail delivery for the award / regret notifications (optional - without it you can download .eml drafts).
# Gmail: smtp.gmail.com / 587 / starttls with an "app password" (Google Account > Security > App passwords).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
